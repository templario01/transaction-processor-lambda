{
  "name": "transaction-processor-cdk",
  "version": "0.1.0",
  "description": "Transaction Processor with SQS, SNS, DynamoDB and Lambda",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "synth": "cdk synth",
    "start": "node --env-file .env dist/lambda/local-run",
    "lint": "eslint 'lib/**/*.{ts,js}' 'bin/**/*.{ts,js}' 'lambda/**/*.{ts,js}' --max-warnings=0",
    "format": "prettier --write 'lib/**/*.{ts,js,json}' 'bin/**/*.{ts,js,json}' 'lambda/**/*.{ts,js,json}'"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1057.0",
    "@aws-sdk/client-sns": "^3.1057.0",
    "@aws-sdk/client-sqs": "^3.1057.0",
    "@aws-sdk/lib-dynamodb": "^3.1057.0",
    "aws-cdk-lib": "^2.257.0",
    "constructs": "^10.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.119",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "aws-cdk": "^2.257.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.5.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.1.0",
    "typescript": "^6.0.3"
  }
}
